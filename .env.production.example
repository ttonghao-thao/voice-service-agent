# Copy this file to .env.production on the cloud server. Never commit the real file.
APP_ENV=production
AUTH_MODE=oidc
PUBLIC_ORIGIN=https://support.example.com

# Use URL-safe random values. Compose injects the service URLs into the containers.
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_URL_SAFE_REDIS_PASSWORD
AUTH_COOKIE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

TENANT_ID=REPLACE_WITH_TENANT_ID
KNOWLEDGE_BASE_IDS=REPLACE_WITH_COMMA_SEPARATED_CUEKB_UUIDS
OIDC_ISSUER=https://id.example.com/
OIDC_AUDIENCE=REPLACE_WITH_OIDC_CLIENT_AND_AUDIENCE
OIDC_JWKS_URL=https://id.example.com/.well-known/jwks.json
OIDC_AUTHORIZATION_URL=https://id.example.com/authorize
OIDC_TOKEN_URL=https://id.example.com/oauth/token
OIDC_CLIENT_SECRET=REPLACE_IF_REQUIRED_BY_IDP

AGENT_PROVIDER=openai
AGENT_MODEL=REPLACE_WITH_VERIFIED_TOOL_CAPABLE_MODEL
OPENAI_API_KEY=REPLACE_WITH_MODEL_API_KEY
AGENT_BASE_URL=
AGENT_DEADLINE_MS=12000
MAX_AGENT_RUNS=16

CUEKB_MODE=real
CUEKB_BASE_URL=https://cuekb.example.com
CUEKB_API_KEY=REPLACE_WITH_SCOPED_CUEKB_API_KEY
CUEKB_SEARCH_MODE=auto
CUEKB_TOP_K=5
WEATHER_MODE=real
WEATHER_PROVIDER=http_contract
WEATHER_BASE_URL=https://weather.example.com
WEATHER_API_KEY=REPLACE_WITH_WEATHER_API_KEY

# Production may start with voice unavailable until P0 acceptance has passed.
# Keep disabled until the target deployment passes D01 real-service review.
VOICE_PROVIDER=disabled
VOICECHAT_WS_URL=wss://voice.example.com/v1/realtime
VOICECHAT_HEALTH_URL=https://voice.example.com/health
VOICECHAT_API_KEY=REPLACE_WITH_VOICECHAT_API_KEY
VOICECHAT_API_VERSION=REPLACE_WITH_VERIFIED_API_VERSION
VOICECHAT_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_CHARACTERS
# Set basic or enhanced only after the matching real probe and audio review.
VOICECHAT_CAPABILITY_MODE=unverified
VOICECHAT_INTEGRATION_VERIFIED=false
CUEKB_API_REVISION=REPLACE_WITH_DEPLOYED_CUEKB_REVISION
VOICE_SESSION_MAX_SECONDS=105
MAX_VOICE_SESSIONS=8

DEFAULT_LOCALE=zh-CN
REQUIRED_VOICE_LANGUAGES=zh-CN
EXTERNAL_TRACING_ENABLED=false
RETENTION_DAYS=30
REQUEST_LIMIT_PER_MINUTE=60
