FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
WORKDIR /app
RUN pip install --no-cache-dir uv==0.11.28
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY apps/api apps/api
COPY config config
ENV PYTHONPATH=/app/apps/api PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1
RUN groupadd --gid 10001 service && useradd --uid 10001 --gid service --no-create-home service && mkdir /app/data && chown service:service /app/data
USER service
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log", "--ws-max-size", "16384", "--ws-max-queue", "8", "--timeout-graceful-shutdown", "20"]
