FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254
WORKDIR /app
COPY requirements.txt ./
RUN --mount=type=cache,id=voice-service-agent-api-pip,target=/root/.cache/pip,sharing=locked \
    --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export PIP_CERT=/run/secrets/proxy_ca; fi; \
    python -m pip install --disable-pip-version-check -r requirements.txt
COPY apps/api apps/api
COPY config config
COPY scripts/verify_deployment.py scripts/verify_deployment.py
COPY scripts/configure_native_cuekb.py scripts/configure_native_cuekb.py
COPY scripts/probe_voicechat.py scripts/probe_voicechat.py
COPY scripts/validate_native_cuekb.py scripts/validate_native_cuekb.py
COPY scripts/run_native_cuekb_validation.py scripts/run_native_cuekb_validation.py
COPY artifacts/native-cuekb/cases.json validation/native-cuekb/cases.json
COPY artifacts/native-cuekb/*.wav validation/native-cuekb/
ENV PYTHONPATH=/app/apps/api:/app PYTHONUNBUFFERED=1
RUN chmod -R u=rwX,go=rX apps/api config scripts validation \
    && groupadd --gid 10001 service \
    && useradd --uid 10001 --gid service --no-create-home service \
    && mkdir /app/data && chown service:service /app/data
USER service
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log", "--ws-max-size", "16384", "--ws-max-queue", "8", "--timeout-graceful-shutdown", "20"]
