+    def _capture_write(self, seq_id: int, filename: str, payload: bytes) -> int:
+        if not self._capture_enabled(seq_id):
+            return -1
+        with self._capture_lock:
+            if self._capture_bytes + len(payload) > VOICECHAT_CAPTURE_MAX_BYTES:
+                raise RuntimeError("Isolated VoiceChat capture exceeded VOICECHAT_CAPTURE_MAX_BYTES")
+            path = self._capture_path(seq_id) / filename
+            offset = path.stat().st_size if path.exists() else 0
+            flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND
+            if hasattr(os, "O_NOFOLLOW"):
+                flags |= os.O_NOFOLLOW
+            descriptor = os.open(path, flags, 0o600)
+            try:
+                view = memoryview(payload)
+                while view:
+                    view = view[os.write(descriptor, view) :]
+            finally:
+                os.close(descriptor)
+            self._capture_bytes += len(payload)
+            return offset
