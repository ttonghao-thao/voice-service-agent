     @_log_time("Execute")
     def execute(self, requests):
+        """END is cleanup, including after failed inference; never decode on END."""
+        responses = [None] * len(requests)
+        active, indexes = [], []
+        for index, request in enumerate(requests):
+            end = from_dlpack(pb_utils.get_input_tensor_by_name(request, "END"))
+            if not end[0].item():
+                active.append(request)
+                indexes.append(index)
+                continue
+            final_asr = self._finalize_sequence(request.correlation_id())
+            responses[index] = pb_utils.InferenceResponse(output_tensors=[
+                pb_utils.Tensor(name, np.array([final_asr.encode("utf-8") if name == "output_asr_text" else b""], dtype=np.object_))
+                for name in ("output_text", "output_asr_text", "output_function_text")
+            ] + [pb_utils.Tensor("output_audio", np.empty((1, 0), dtype=np.float32))])
+        if active:
+            for index, response in zip(indexes, self._execute_active(active), strict=True):
+                responses[index] = response
+        return responses
+
+    def _finalize_sequence(self, seq_id):
+        try:
+            state = self._seq_mgr[seq_id]
+        except (KeyError, ValueError):
+            return ""
+        self._seq_mgr.mark_end(seq_id)
+        state.fn_call["extract_cancelled"] = True
+        state.fn_call["inject_cancelled"] = True
+        # Abort before joining: an outstanding anext must be unblocked first.
+        for cleanup in (lambda: self._run_coro(self._vllm_llm_cleanup(seq_id)),
+                        lambda: self.model.tts.stream_abort_request(seq_id)):
+            try:
+                cleanup()
+            except Exception as exc:
+                pb_utils.Logger.log_error(f"[seq {seq_id}] Cleanup error_type={type(exc).__name__}")
+        for threads in (self._extraction_threads, self._injection_threads):
+            worker = threads.pop(seq_id, None)
+            if worker and worker.is_alive():
+                worker.join(timeout=1.0)
+        with torch.inference_mode():
+            self._append_rnnt_display_output(state, agent_bos_fired=False, force_publish=True, close_turn=True)
+        final_asr = state.rnnt_display_pending_text
+        self._voice_diagnostic(state, "sequence.end", state=state.fn_call["state"])
+        self._seq_mgr.remove(seq_id)
+        return final_asr
+
+    def _execute_active(self, requests):
         logger = pb_utils.Logger
         responses = []
