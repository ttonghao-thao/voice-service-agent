{#-
    Voicechat tool-calling chat template for Nano v2.

    Adapted from the full nano_v2_chat_template.jinja released with Nemotron Nano v2
    (see https://huggingface.co/nvidia/NVIDIA-Nemotron-Nano-9B-v2).
    This template renders only the system prompt (with tool definitions
    injected), since the s2s_voicechat backend receives audio as user
    input and tokenises the system prompt separately.

    Variables:
      - system_message (str): original system prompt text.
      - tools (list|None): OpenAI-format tool definitions.

    ack_messages fields are stripped from the LLM-visible tool JSON and
    emitted in a separate <TOOL_ACK_MESSAGES> block for server-side use.
-#}
{{- system_message -}}
{%- if tools -%}
    {%- if system_message != '' -%}
        {{- '\n\n' -}}
    {%- endif -%}
    {{- 'You can use the following tools to assist the user if required:' -}}
    {{- '\n<AVAILABLE_TOOLS>[' -}}
    {%- for tool in tools -%}
        {%- set _t = (tool.function if tool.function is defined else tool) -%}
        {%- set _d = {} -%}
        {%- for k, v in _t.items() if k not in ('type', 'ack_messages') -%}
            {%- set _ = _d.update({k: v}) -%}
        {%- endfor -%}
        {{- _d | tojson -}}
        {{- ', ' if not loop.last else '' -}}
    {%- endfor -%}
    {{- ']</AVAILABLE_TOOLS>\n\n' -}}

    {{- 'When the session instructions require a tool, call one matching registered tool. Use this format with arguments matching its schema:\n' -}}
    {%- set _first = (tools[0].function if tools[0].function is defined else tools[0]) -%}
    {%- if _first.name == 'search_knowledge_base' -%}
        {{- 'Format-only example. User: "Can Product AX be shipped, and how should it be stored after opening?"\n' -}}
        {{- '<TOOLCALL>[{"name": "search_knowledge_base", "arguments": {"query": "Can Product AX be shipped, and how should it be stored after opening?"}}]' -}}
    {%- else -%}
        {{- '<TOOLCALL>[{"name": "registered_tool_name", "arguments": {"argument_name": "argument_value"}}]' -}}
    {%- endif -%}
    {{- '</TOOLCALL>\n\n' -}}
    {{- 'Use the real user request, exact product and every requested detail. Never reuse example names or attributes. A named-product first question requires a matching knowledge tool even without previous tool history.\n' -}}

    {{- 'The user will execute tool-calls and return responses from tool(s) in this format:\n' -}}
    {{- '<TOOL_RESPONSE>[{"status": "example_status", "speech_text": "example_authorized_reply"}]</TOOL_RESPONSE>\n\n' -}}

    {{- 'Follow the session instructions and tool contracts when handling tool results.\n' -}}
    {{- 'If a registered tool covers the request, call it instead of saying that you lack access to the information.\n' -}}
    {{- 'Do not retry the same tool request or issue multiple tool calls simultaneously.\n' -}}
    {{- 'Speak only as permitted by the session answer policy and the returned tool result.' -}}

    {%- set _ack_list = [] -%}
    {%- for tool in tools -%}
        {%- set _t = (tool.function if tool.function is defined else tool) -%}
        {%- if _t.get('ack_messages') -%}
            {%- set _ = _ack_list.append({'name': _t.name, 'ack_messages': _t.ack_messages}) -%}
        {%- endif -%}
    {%- endfor -%}
    {%- if _ack_list -%}
        {{- '\n<TOOL_ACK_MESSAGES>' -}}
        {{- _ack_list | tojson -}}
        {{- '</TOOL_ACK_MESSAGES>' -}}
    {%- endif -%}
{%- endif -%}
