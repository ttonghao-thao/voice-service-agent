# 本期英文语音→CueKB→口述验证只需填写本文件；不要修改 Compose 中的固定模式。
# 复制为 .env 后替换所有 REPLACE_、example.com、证书路径、镜像标签和 KB UUID。
# .env 包含凭据，不要提交仓库。其余模式、容量和超时使用代码与 Compose 默认值。

# 同一源码版本独立构建的 API/Web 镜像共用一个标签。
IMAGE_TAG=0123456789ab
PUBLIC_ORIGIN=https://voice.example.com:8087
WEB_TLS_CERT_FILE=/etc/letsencrypt/live/voice.example.com/fullchain.pem
WEB_TLS_KEY_FILE=/etc/letsencrypt/live/voice.example.com/privkey.pem

# 数据库、Redis 和服务端固定知识范围；密码使用 URL 安全随机字符。
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_URL_SAFE_REDIS_PASSWORD
KNOWLEDGE_BASE_IDS=11111111-1111-4111-8111-111111111111

# 文本模型：官方 OpenAI 用 openai 且不设 AGENT_BASE_URL；兼容服务用 compatible 并填该地址。
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-4.1
OPENAI_API_KEY=REPLACE_WITH_MODEL_API_KEY
# AGENT_BASE_URL=https://model.example.com/v1

# 独立 CueKB 服务的基地址；应用附加 /v1/search。
CUEKB_BASE_URL=https://cuekb.example.com
CUEKB_API_KEY=REPLACE_WITH_SCOPED_CUEKB_API_KEY

# 独立 VoiceChat 服务；版本和镜像 digest 在探针命令中记录，不属于应用运行配置。
VOICECHAT_WS_URL=REPLACE_WITH_DEPLOYED_VOICECHAT_WSS_URL
VOICECHAT_API_KEY=REPLACE_WITH_VOICECHAT_API_KEY
