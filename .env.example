# Copy to .env and fill every required value. Keep .env private.
AUTH_MODE=local
# Public HTTPS origin for the test portal, including :8087 when used in its URL.
PUBLIC_ORIGIN=REPLACE_WITH_PUBLIC_HTTPS_ORIGIN
# Bind the host API port only to its private IPv4 address (RFC 1918).
API_BIND_ADDRESS=REPLACE_WITH_HOST_PRIVATE_IPV4
# Absolute host paths to a trusted certificate and matching private key.
WEB_TLS_CERT_FILE=REPLACE_WITH_ABSOLUTE_TLS_CERTIFICATE_PATH
WEB_TLS_KEY_FILE=REPLACE_WITH_ABSOLUTE_TLS_PRIVATE_KEY_PATH
# The portal binds publicly on HTTPS 8087; API binds to API_BIND_ADDRESS:8088.

# Build these tags with docker build before deployment, or load/pull the same tags on the server.
# Use a unique release tag for each build; migrate and api share API_IMAGE.
API_IMAGE=REPLACE_WITH_API_IMAGE_TAG
WEB_IMAGE=REPLACE_WITH_WEB_IMAGE_TAG

# Use URL-safe random values. Compose constructs DATABASE_URL and REDIS_URL internally.
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_URL_SAFE_REDIS_PASSWORD
AUTH_COOKIE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
LOCAL_USERS_JSON=REPLACE_WITH_JSON_ARRAY_OF_HASHED_TEST_USERS

TENANT_ID=REPLACE_WITH_TENANT_ID
KNOWLEDGE_BASE_IDS=REPLACE_WITH_COMMA_SEPARATED_CUEKB_UUIDS
AGENT_PROVIDER=openai
AGENT_MODEL=REPLACE_WITH_VERIFIED_TOOL_CAPABLE_MODEL
OPENAI_API_KEY=REPLACE_WITH_MODEL_API_KEY
AGENT_BASE_URL=
AGENT_DEADLINE_MS=12000
MAX_AGENT_RUNS=16

CUEKB_MODE=real
# 独立 CueKB 服务的 HTTPS 基地址；应用会在后面加 /v1/search。
CUEKB_BASE_URL=REPLACE_WITH_CUEKB_HTTPS_BASE_URL
CUEKB_API_KEY=REPLACE_WITH_SCOPED_CUEKB_API_KEY
CUEKB_SEARCH_MODE=auto
CUEKB_TOP_K=5
# Comma-separated deployment allowlist. Disabled providers need no endpoint or key.
ENABLED_TOOLS=search_knowledge
# Keep voice disabled until the target provider passes the real capability and audio review.
VOICE_PROVIDER=disabled
VOICECHAT_WS_URL=
VOICECHAT_HEALTH_URL=
VOICECHAT_API_KEY=
VOICECHAT_API_VERSION=
VOICECHAT_IMAGE_DIGEST=
# Set basic or enhanced only after the matching real probe and audio review.
VOICECHAT_CAPABILITY_MODE=unverified
VOICECHAT_INTEGRATION_VERIFIED=false
CUEKB_API_REVISION=REPLACE_WITH_DEPLOYED_CUEKB_REVISION
VOICE_SESSION_MAX_SECONDS=105
MAX_VOICE_SESSIONS=8

DEFAULT_LOCALE=en-US
REQUIRED_VOICE_LANGUAGES=en-US
EXTERNAL_TRACING_ENABLED=false
RETENTION_DAYS=30
REQUEST_LIMIT_PER_MINUTE=60
