# 复制为 .env。按 ENABLED_TOOLS 保留已启用服务的配置，并替换保留的占位值。
# .env 含凭据，设置权限 600。生产运行默认值和完整部署步骤见 docs/deployment.md。

# API 和 Web 预构建镜像共用的标签。
IMAGE_TAG=0123456789ab

# 门户 HTTPS origin 和部署机上的证书绝对路径。
# 使用公网 IPv4 时填 https://实际IP:8087，服务端证书的 SAN 须包含该 IP。
# 使用私有 CA 时，按部署手册将合并 CA bundle 只读挂载给同一 Compose 的 api。
PUBLIC_ORIGIN=https://voice.example.com:8087
WEB_TLS_CERT_FILE=/etc/letsencrypt/live/voice.example.com/fullchain.pem
WEB_TLS_KEY_FILE=/etc/letsencrypt/live/voice.example.com/privkey.pem

# PostgreSQL、Redis 和 LiveKit 各凭据分别用 openssl rand -hex 32 生成。
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_URL_SAFE_REDIS_PASSWORD

# 默认使用 Sophon Live。切换 NVIDIA 的填写方式见部署手册。
VOICE_PROVIDER=sophon_live
SOPHON_LIVE_WS_URL=wss://sx.ppy8.xyz:14080/v1/live/sessions
# 上游允许匿名访问时 Key 留空。语言可按上游选择 zh-CN 或 en-US。
SOPHON_LIVE_API_KEY=
SOPHON_LIVE_LOCALE=zh-CN

# Qwen 原生 task 解析。填工作空间的 OpenAI-compatible base URL、模型名和 Key。
DELEGATION_ROUTER_BASE_URL=https://REPLACE_WITH_WORKSPACE_HOST/compatible-mode/v1
DELEGATION_ROUTER_MODEL=qwen3.7-flash
DELEGATION_ROUTER_API_KEY=REPLACE_WITH_INTENT_LLM_API_KEY

# 同 Compose 的 LiveKit WSS 入口。填证书覆盖的域名或 IPv4 及 7880 端口，浏览器和 API 均须可达。
LIVEKIT_URL=wss://voice.example.com:7880
# 填客户端和 API 可达的宿主机 IPv4。公网部署使用实际公网 IPv4。
LIVEKIT_NODE_IP=REPLACE_WITH_REACHABLE_HOST_IPV4
# 可选。填 LiveKit 容器接收媒体流量的网卡名，例如 eth2。留空使用默认候选收集。
LIVEKIT_RTC_INTERFACE=
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_RANDOM_LIVEKIT_SECRET

# Sophon 保留 web_search。停用 CueKB 时移除 search_knowledge 及下方 CueKB 三项。
# 停用天气时移除 weather 及 WEATHER_BASE_URL、WEATHER_API_KEY。
ENABLED_TOOLS=search_knowledge,weather,web_search

# CueKB 独立服务的 API 根地址，API 容器须可达。应用会拼接 /v2/evidence/query 和 /v2/evidence/validate。
CUEKB_BASE_URL=https://cuekb.example.com
# 填授予目标库 read 权限的业务 Key 原值。多个知识库 UUID 用英文逗号分隔。
CUEKB_API_KEY=REPLACE_WITH_CUEKB_READ_API_KEY
KNOWLEDGE_BASE_IDS=REPLACE_WITH_CUEKB_KB_UUID

# QWeather 控制台分配的专属 HTTPS API Host 和 Key。
WEATHER_BASE_URL=https://REPLACE_WITH_ASSIGNED_HOST.qweatherapi.com
WEATHER_API_KEY=REPLACE_WITH_QWEATHER_API_KEY

# Tavily Search Key，用于公开知识查询和受控兜底。
WEB_SEARCH_API_KEY=REPLACE_WITH_TAVILY_API_KEY
