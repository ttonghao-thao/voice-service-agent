# 完整填写示例：复制为 .env 后，替换所有 REPLACE_ 值、示例地址、私网 IP、证书路径、
# 镜像标签和 KB UUID。example.com 不是真实服务；.env 含密钥，勿提交仓库。
AUTH_MODE=local
# 浏览器访问的实际 HTTPS origin，必须与证书域名一致，包含 8087 端口。
PUBLIC_ORIGIN=https://voice.example.com:8087
# 部署机实际拥有的 RFC 1918 私网 IPv4；API 只在该地址的 8088 端口开放。
API_BIND_ADDRESS=192.168.10.20
# 部署机上证书和私钥的绝对路径，文件须存在且可读。
WEB_TLS_CERT_FILE=/etc/letsencrypt/live/voice.example.com/fullchain.pem
WEB_TLS_KEY_FILE=/etc/letsencrypt/live/voice.example.com/privkey.pem

# 先独立构建并将相同标签的镜像送到部署机；两个标签须对应同一版源码。
API_IMAGE=voice-service-agent-api:0123456789ab
WEB_IMAGE=voice-service-agent-web:0123456789ab

# 用 URL 安全的随机值；Compose 在容器内构造 DATABASE_URL 和 REDIS_URL。
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_URL_SAFE_REDIS_PASSWORD
AUTH_COOKIE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# 哈希用 PYTHONPATH=apps/api uv run python scripts/hash_test_password.py 交互生成。
# 至少两个独立 customer 账号；单引号保留 JSON 原样供 Compose 读取。
LOCAL_USERS_JSON='[{"id":"alice","password_hash":"REPLACE_WITH_ALICE_PBKDF2_HASH","role":"customer","knowledge_base_ids":["11111111-1111-4111-8111-111111111111"]},{"id":"bob","password_hash":"REPLACE_WITH_BOB_PBKDF2_HASH","role":"customer","knowledge_base_ids":["22222222-2222-4222-8222-222222222222"]}]'

TENANT_ID=example-tenant
# 下列 UUID 必须是同一租户在目标 CueKB 实际授权的 KB；账号范围须为其子集。
KNOWLEDGE_BASE_IDS=11111111-1111-4111-8111-111111111111,22222222-2222-4222-8222-222222222222
AGENT_PROVIDER=openai
# 使用已验证支持本项目工具调用的模型；下方名称仅示范配置格式。
AGENT_MODEL=gpt-4.1
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# OpenAI 官方端点时留空；兼容服务改用 AGENT_PROVIDER=compatible 并填 HTTPS base URL。
AGENT_BASE_URL=
AGENT_DEADLINE_MS=12000
MAX_AGENT_RUNS=16

CUEKB_MODE=real
# 独立 CueKB 服务的 HTTPS 基地址；应用会在后面加 /v1/search。
CUEKB_BASE_URL=https://cuekb.example.com
CUEKB_API_KEY=REPLACE_WITH_SCOPED_CUEKB_API_KEY
CUEKB_SEARCH_MODE=auto
CUEKB_TOP_K=5
# 部署允许的工具，逗号分隔；未启用的供应商不需要地址或密钥。
ENABLED_TOOLS=search_knowledge
# 独立 VoiceChat 通过真实协议和音频验证后再启用。
VOICE_PROVIDER=disabled
VOICECHAT_WS_URL=
VOICECHAT_HEALTH_URL=
VOICECHAT_API_KEY=
VOICECHAT_API_VERSION=
VOICECHAT_IMAGE_DIGEST=
# 仅在相应真实验证后设为 basic 或 enhanced。
VOICECHAT_CAPABILITY_MODE=unverified
VOICECHAT_INTEGRATION_VERIFIED=false
CUEKB_API_REVISION=REPLACE_WITH_DEPLOYED_CUEKB_REVISION
VOICE_SESSION_MAX_SECONDS=105
MAX_VOICE_SESSIONS=8

DEFAULT_LOCALE=en-US
REQUIRED_VOICE_LANGUAGES=en-US
EXTERNAL_TRACING_ENABLED=false
RETENTION_DAYS=30
REQUEST_LIMIT_PER_MINUTE=60
