# 英文语音 → CueKB → 口述的验证部署只需填写本文件中的变量。
# 用法：cp .env.example .env，然后替换所有 REPLACE_、example.com、示例 UUID、
# 证书路径和镜像标签。.env 含真实凭据，权限建议设为 600，不要提交仓库。
# 本模板已列出全部必填部署值和业务问答总预算；身份模式、启用工具、容量和语言由
# Compose/代码固定。生产集成地址必须从 API 容器内可达。

# -----------------------------------------------------------------------------
# 1. 应用镜像、公网入口和 TLS
# -----------------------------------------------------------------------------

# API/Web 两个预构建镜像共用的标签。示例为 Git commit 短 SHA；部署机必须已有
# voice-service-agent-api:<IMAGE_TAG> 和 voice-service-agent-web:<IMAGE_TAG>。
IMAGE_TAG=0123456789ab

# 浏览器实际访问的完整 HTTPS origin；必须与证书域名及对外端口一致。
# 只填 scheme + host + port，不得带路径、query、用户名或密码。
# 示例：https://voice.example.com:8087
PUBLIC_ORIGIN=https://voice.example.com:8087

# 部署机上的证书链和私钥可读绝对路径；Compose 会以只读方式挂载到 Web 容器。
# 示例适用于 Let's Encrypt；自有 PKI 请改为实际 full chain 和 private key 路径。
WEB_TLS_CERT_FILE=/etc/letsencrypt/live/voice.example.com/fullchain.pem
WEB_TLS_KEY_FILE=/etc/letsencrypt/live/voice.example.com/privkey.pem

# -----------------------------------------------------------------------------
# 2. PostgreSQL、Redis 和固定知识库范围
# -----------------------------------------------------------------------------

# Compose 会把密码直接组合到连接 URL；使用高强度 URL-safe 随机值。
# 建议只用 A-Z a-z 0-9 . _ ~ -，避免 @ : / # % $ 和空格导致 URL 或 Compose 解析歧义。
POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_URL_SAFE_REDIS_PASSWORD

# CueKB 中允许客户通话检索的真实知识库 UUID，不是库名。
# 多个库用英文逗号分隔，例如：11111111-1111-4111-8111-111111111111,22222222-2222-4222-8222-222222222222
# 值必须为合法、唯一的 UUID，且 CUEKB_API_KEY 必须具有对应访问权限。
KNOWLEDGE_BASE_IDS=11111111-1111-4111-8111-111111111111

# -----------------------------------------------------------------------------
# 3. 一期原生 Function Calling（不部署额外答案模型）
# -----------------------------------------------------------------------------

# VoiceChat 自行选择是否调用 search_knowledge_base，并根据 CueKB 证据生成语音答案。
# disabled 关闭独立文本答案模型；不需要 AGENT_MODEL、OPENAI_API_KEY、AGENT_BASE_URL。
AGENT_PROVIDER=disabled

# 原生路径的单次工具检索期限；不控制 VoiceChat 回答时长。
AGENT_DEADLINE_MS=60000
QA_EXECUTION_MODE=dual_tools
QA_ANSWER_POLICY=general_qa
QA_TOOLSET_VERSION=cuekb-native-v1
QA_EXTERNAL_FALLBACK_ENABLED=false
QA_MAX_RETRIEVAL_CALLS=1
# 一期 native relay 按用户输入限制实际检索；默认 2，可设为 1；独立于旧 QA_MAX_RETRIEVAL_CALLS。
VOICE_MAX_RETRIEVALS_PER_INPUT=2
QA_PROVIDER_ANSWER_TIMEOUT_MS=30000

# 修改模式/策略后必须新建 Conversation。
# 部署脚本在迁移后显式应用 config/voice-tools.yaml，替换旧的双工具目录。
# 模型只填写 query；KB 范围、鉴权、可信上下文和过滤条件由服务器处理。

# 可选后台操作员凭据；不配置时仍可在 API 容器内运行 configure_native_cuekb.py。
# TOOLS_ADMIN_API_KEY=REPLACE_WITH_OPERATOR_API_KEY

# -----------------------------------------------------------------------------
# 4. 独立 CueKB 服务
# -----------------------------------------------------------------------------

# CueKB HTTP/HTTPS 基地址；不要附加 /v1/search，应用会自动附加。
# HTTP 只用于已隔离、受控且从 API 容器可达的内部网络。
# 示例：http://cuekb.internal.example.com:8085 或 https://cuekb.example.com
CUEKB_BASE_URL=https://cuekb.example.com

# 仅授予上述 KNOWLEDGE_BASE_IDS 检索权限的 CueKB Bearer token；不要使用管理员 key。
CUEKB_API_KEY=REPLACE_WITH_SCOPED_CUEKB_API_KEY

# -----------------------------------------------------------------------------
# 5. 独立 NVIDIA VoiceChat 服务
# -----------------------------------------------------------------------------

# VoiceChat 的完整 WebSocket endpoint，并包含 /v1/realtime。
# 同主机或受控隔离内网可使用 WS，例如：ws://178.18.105.119:9000/v1/realtime。
# 跨主机非受控网络使用 WSS，例如：wss://voicechat.internal.example.com/v1/realtime。
# WS 会以明文传输 Bearer token，不得将该 endpoint 暴露到公网。
VOICECHAT_WS_URL=REPLACE_WITH_DEPLOYED_VOICECHAT_WS_URL

# VoiceChat 服务或其前置安全入口认可的 Bearer token。应用在 WebSocket 握手中发送
# Authorization: Bearer <VOICECHAT_API_KEY>。这不是 NGC key、OPENAI_API_KEY 或镜像 digest。
# 格式示例：vc_live_A7f92kLm4xP8qR3n6sT1（只是格式示例，必须换成真实密钥）。
VOICECHAT_API_KEY=REPLACE_WITH_VOICECHAT_API_KEY

# VoiceChat API 版本、容器镜像 digest 和实测证据在 scripts/probe_voicechat.py 命令/报告中记录，
# 不属于应用运行配置，不应额外写入 .env。
