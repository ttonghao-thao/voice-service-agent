{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "citation_id": {
          "title": "Citation Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        },
        "business_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Version"
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "context_parts": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Context Parts",
          "type": "array"
        },
        "context_truncated": {
          "default": false,
          "title": "Context Truncated",
          "type": "boolean"
        },
        "context_omitted": {
          "default": false,
          "title": "Context Omitted",
          "type": "boolean"
        },
        "hits_omitted": {
          "default": 0,
          "minimum": 0,
          "title": "Hits Omitted",
          "type": "integer"
        },
        "relations": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Relations",
          "type": "array"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        },
        "retrieval_id": {
          "title": "Retrieval Id",
          "type": "string"
        },
        "retrieval_status": {
          "default": "ok",
          "enum": [
            "ok",
            "degraded",
            "not_found",
            "needs_clarification"
          ],
          "title": "Retrieval Status",
          "type": "string"
        },
        "evidence_status": {
          "default": "unassessed",
          "enum": [
            "unassessed",
            "sufficient",
            "insufficient",
            "conflicting"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "degraded_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Degraded Reasons",
          "type": "array"
        },
        "scope_limited": {
          "default": false,
          "title": "Scope Limited",
          "type": "boolean"
        },
        "content_revisions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Content Revisions",
          "type": "object"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "title_path": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Title Path",
          "type": "array"
        },
        "anchor": {
          "additionalProperties": true,
          "title": "Anchor",
          "type": "object"
        },
        "retrieval_sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Retrieval Sources",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "authorized_kb_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Authorized Kb Ids",
          "type": "array"
        },
        "is_mock": {
          "default": false,
          "title": "Is Mock",
          "type": "boolean"
        }
      },
      "required": [
        "citation_id",
        "document_id",
        "chunk_id",
        "title",
        "version_id",
        "content",
        "trace_id",
        "retrieval_id",
        "rank"
      ],
      "title": "Citation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "knowledge",
      "default": "knowledge",
      "title": "Kind",
      "type": "string"
    },
    "result_id": {
      "title": "Result Id",
      "type": "string"
    },
    "directive": {
      "enum": [
        "answer_from_evidence",
        "ask_clarification",
        "report_insufficient",
        "report_failure"
      ],
      "title": "Directive",
      "type": "string"
    },
    "retrieval_status": {
      "anyOf": [
        {
          "enum": [
            "ok",
            "degraded",
            "not_found",
            "needs_clarification"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Retrieval Status"
    },
    "evidence_status": {
      "anyOf": [
        {
          "enum": [
            "unassessed",
            "sufficient",
            "insufficient",
            "conflicting"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Evidence Status"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "degraded_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Degraded Reasons",
      "type": "array"
    },
    "scope_limited": {
      "default": false,
      "title": "Scope Limited",
      "type": "boolean"
    },
    "application_limited": {
      "default": false,
      "title": "Application Limited",
      "type": "boolean"
    },
    "hits_omitted": {
      "default": 0,
      "minimum": 0,
      "title": "Hits Omitted",
      "type": "integer"
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "message": {
      "default": "",
      "maxLength": 500,
      "title": "Message",
      "type": "string"
    },
    "is_mock": {
      "default": false,
      "title": "Is Mock",
      "type": "boolean"
    },
    "trace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Trace Id"
    }
  },
  "required": [
    "directive",
    "retrieval_status",
    "evidence_status"
  ],
  "title": "KnowledgeResultView",
  "type": "object"
}
