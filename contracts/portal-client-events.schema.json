{
  "$defs": {
    "EmptyEventPayload": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        }
      },
      "title": "EmptyEventPayload",
      "type": "object"
    },
    "PlaybackAckPayload": {
      "additionalProperties": false,
      "properties": {
        "response_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Response Id",
          "type": "string"
        },
        "played_samples": {
          "minimum": 0,
          "title": "Played Samples",
          "type": "integer"
        }
      },
      "required": [
        "response_id",
        "played_samples"
      ],
      "title": "PlaybackAckPayload",
      "type": "object"
    },
    "PlaybackStopPayload": {
      "additionalProperties": false,
      "properties": {
        "response_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Id"
        }
      },
      "title": "PlaybackStopPayload",
      "type": "object"
    },
    "PortalAudioAppend": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "type": {
          "const": "portal.audio.append",
          "title": "Type",
          "type": "string"
        },
        "event_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Id"
        },
        "seq": {
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "payload": {
          "$ref": "#/$defs/PortalAudioPayload"
        }
      },
      "required": [
        "epoch",
        "type",
        "seq",
        "payload"
      ],
      "title": "PortalAudioAppend",
      "type": "object"
    },
    "PortalAudioPayload": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "pcm16",
          "title": "Format",
          "type": "string"
        },
        "sample_rate": {
          "const": 24000,
          "title": "Sample Rate",
          "type": "integer"
        },
        "audio": {
          "maxLength": 5120,
          "minLength": 1,
          "title": "Audio",
          "type": "string"
        }
      },
      "required": [
        "format",
        "sample_rate",
        "audio"
      ],
      "title": "PortalAudioPayload",
      "type": "object"
    },
    "PortalInterrupt": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "type": {
          "const": "portal.interrupt",
          "title": "Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/EmptyEventPayload"
        }
      },
      "required": [
        "epoch",
        "type"
      ],
      "title": "PortalInterrupt",
      "type": "object"
    },
    "PortalPlaybackAck": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "type": {
          "const": "portal.playback.ack",
          "title": "Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/PlaybackAckPayload"
        }
      },
      "required": [
        "epoch",
        "type",
        "payload"
      ],
      "title": "PortalPlaybackAck",
      "type": "object"
    },
    "PortalPlaybackStop": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "type": {
          "const": "portal.playback.stop",
          "title": "Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/PlaybackStopPayload"
        }
      },
      "required": [
        "epoch",
        "type"
      ],
      "title": "PortalPlaybackStop",
      "type": "object"
    },
    "PortalSessionClose": {
      "additionalProperties": false,
      "properties": {
        "epoch": {
          "minimum": 0,
          "title": "Epoch",
          "type": "integer"
        },
        "type": {
          "const": "portal.session.close",
          "title": "Type",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/EmptyEventPayload"
        }
      },
      "required": [
        "epoch",
        "type"
      ],
      "title": "PortalSessionClose",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "portal.audio.append": "#/$defs/PortalAudioAppend",
      "portal.interrupt": "#/$defs/PortalInterrupt",
      "portal.playback.ack": "#/$defs/PortalPlaybackAck",
      "portal.playback.stop": "#/$defs/PortalPlaybackStop",
      "portal.session.close": "#/$defs/PortalSessionClose"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/PortalAudioAppend"
    },
    {
      "$ref": "#/$defs/PortalPlaybackAck"
    },
    {
      "$ref": "#/$defs/PortalPlaybackStop"
    },
    {
      "$ref": "#/$defs/PortalInterrupt"
    },
    {
      "$ref": "#/$defs/PortalSessionClose"
    }
  ]
}
