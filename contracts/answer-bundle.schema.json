{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "citation_id": {
          "title": "Citation Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        },
        "business_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Version"
        },
        "cuekb_schema_version": {
          "default": "1",
          "enum": [
            "1",
            "2"
          ],
          "title": "Cuekb Schema Version",
          "type": "string"
        },
        "document_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Name"
        },
        "content_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "score_type": {
          "anyOf": [
            {
              "enum": [
                "rrf",
                "rerank"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score Type"
        },
        "stage_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stage Scores",
          "type": "object"
        },
        "applicability": {
          "$ref": "#/$defs/CueKBApplicability"
        },
        "fact_kind": {
          "default": "statement",
          "enum": [
            "statement",
            "specification",
            "comparison",
            "bundle",
            "general"
          ],
          "title": "Fact Kind",
          "type": "string"
        },
        "dependency_issues": {
          "items": {
            "enum": [
              "unmatched_reference",
              "ambiguous_reference",
              "dependency_limit_exceeded",
              "dependency_cycle",
              "unsafe_dependency"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "title": "Dependency Issues",
          "type": "array"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/CueKBSourceSpan"
          },
          "maxItems": 64,
          "title": "Source Spans",
          "type": "array"
        },
        "processing_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Processing Profile"
        },
        "source_unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Unit Id"
        },
        "block_kind": {
          "default": "text",
          "enum": [
            "text",
            "list",
            "table",
            "heading"
          ],
          "title": "Block Kind",
          "type": "string"
        },
        "context_state": {
          "anyOf": [
            {
              "enum": [
                "disabled",
                "complete",
                "truncated",
                "unresolved"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context State"
        },
        "context_omissions": {
          "items": {
            "enum": [
              "budget_omitted",
              "candidate_limit_reached",
              "dependency_unresolved",
              "unsafe_scope_excluded"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Context Omissions",
          "type": "array"
        },
        "ranking_method": {
          "anyOf": [
            {
              "enum": [
                "keyword_rrf",
                "rrf",
                "rrf_related",
                "rrf_then_rerank"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ranking Method"
        },
        "ranking_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ranking Version"
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "context_parts": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Context Parts",
          "type": "array"
        },
        "context_truncated": {
          "default": false,
          "title": "Context Truncated",
          "type": "boolean"
        },
        "context_omitted": {
          "default": false,
          "title": "Context Omitted",
          "type": "boolean"
        },
        "hits_omitted": {
          "default": 0,
          "minimum": 0,
          "title": "Hits Omitted",
          "type": "integer"
        },
        "relations": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Relations",
          "type": "array"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        },
        "retrieval_id": {
          "title": "Retrieval Id",
          "type": "string"
        },
        "retrieval_status": {
          "default": "ok",
          "enum": [
            "ok",
            "degraded",
            "not_found",
            "needs_clarification"
          ],
          "title": "Retrieval Status",
          "type": "string"
        },
        "evidence_status": {
          "default": "unassessed",
          "enum": [
            "unassessed",
            "sufficient",
            "insufficient",
            "conflicting"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "degraded_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Degraded Reasons",
          "type": "array"
        },
        "scope_limited": {
          "default": false,
          "title": "Scope Limited",
          "type": "boolean"
        },
        "content_revisions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Content Revisions",
          "type": "object"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "title_path": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Title Path",
          "type": "array"
        },
        "anchor": {
          "additionalProperties": true,
          "title": "Anchor",
          "type": "object"
        },
        "retrieval_sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Retrieval Sources",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "authorized_kb_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Authorized Kb Ids",
          "type": "array"
        },
        "is_mock": {
          "default": false,
          "title": "Is Mock",
          "type": "boolean"
        }
      },
      "required": [
        "citation_id",
        "document_id",
        "chunk_id",
        "title",
        "version_id",
        "content",
        "trace_id",
        "retrieval_id",
        "rank"
      ],
      "title": "Citation",
      "type": "object"
    },
    "CueKBApplicability": {
      "additionalProperties": false,
      "properties": {
        "reason_codes": {
          "items": {
            "enum": [
              "missing_binding",
              "no_reviewed_match",
              "structure_missing",
              "scope_conflict"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "title": "Reason Codes",
          "type": "array"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "resolved",
            "unknown",
            "ambiguous"
          ],
          "title": "Status",
          "type": "string"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/CueKBApplicableSubject"
          },
          "maxItems": 8,
          "title": "Subjects",
          "type": "array"
        },
        "conditions": {
          "items": {
            "$ref": "#/$defs/CueKBApplicableCondition"
          },
          "maxItems": 20,
          "title": "Conditions",
          "type": "array"
        }
      },
      "title": "CueKBApplicability",
      "type": "object"
    },
    "CueKBApplicableCondition": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/CueKBSourceSpan"
          },
          "maxItems": 20,
          "title": "Source Spans",
          "type": "array"
        },
        "source_kind": {
          "default": "curated",
          "enum": [
            "curated",
            "parser"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "provenance_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance Id"
        }
      },
      "required": [
        "text"
      ],
      "title": "CueKBApplicableCondition",
      "type": "object"
    },
    "CueKBApplicableSubject": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "display_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "product_model": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Product Model"
        },
        "software_version": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Software Version"
        },
        "source_kind": {
          "default": "curated",
          "enum": [
            "curated",
            "reviewed_alias",
            "parser"
          ],
          "title": "Source Kind",
          "type": "string"
        },
        "provenance_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provenance Id"
        },
        "source_spans": {
          "items": {
            "$ref": "#/$defs/CueKBSourceSpan"
          },
          "maxItems": 20,
          "title": "Source Spans",
          "type": "array"
        }
      },
      "required": [
        "display_name"
      ],
      "title": "CueKBApplicableSubject",
      "type": "object"
    },
    "CueKBSourceSpan": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "default": "text",
          "maxLength": 100,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "text": {
          "maxLength": 32768,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "anchor": {
          "$ref": "#/$defs/SourceAnchor"
        },
        "parser_item_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parser Item Id"
        },
        "span_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "column_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Index"
        }
      },
      "required": [
        "text"
      ],
      "title": "CueKBSourceSpan",
      "type": "object"
    },
    "PresentationContract": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "verbatim",
            "grounded"
          ],
          "title": "Mode",
          "type": "string"
        },
        "required_conditions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Required Conditions",
          "type": "object"
        },
        "check_basis": {
          "const": "provider_transcript",
          "default": "provider_transcript",
          "title": "Check Basis",
          "type": "string"
        },
        "check_timing": {
          "const": "after_audio",
          "default": "after_audio",
          "title": "Check Timing",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "PresentationContract",
      "type": "object"
    },
    "SourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "heading_path": {
          "items": {
            "type": "string"
          },
          "title": "Heading Path",
          "type": "array"
        },
        "start_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Offset"
        },
        "end_offset": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Offset"
        },
        "bbox": {
          "anyOf": [
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        }
      },
      "title": "SourceAnchor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer_id": {
      "title": "Answer Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "answered",
        "needs_clarification",
        "insufficient_evidence",
        "failed",
        "canceled"
      ],
      "title": "Status",
      "type": "string"
    },
    "display_text": {
      "title": "Display Text",
      "type": "string"
    },
    "speech_text": {
      "title": "Speech Text",
      "type": "string"
    },
    "speech_language": {
      "default": "en-US",
      "title": "Speech Language",
      "type": "string"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "cards": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Cards",
      "type": "array"
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "is_mock": {
      "default": false,
      "title": "Is Mock",
      "type": "boolean"
    },
    "answer_kind": {
      "default": "legacy",
      "enum": [
        "knowledge",
        "general",
        "clarification",
        "legacy"
      ],
      "title": "Answer Kind",
      "type": "string"
    },
    "composition": {
      "default": "legacy",
      "enum": [
        "external_llm",
        "nano_grounded",
        "provider_general",
        "legacy"
      ],
      "title": "Composition",
      "type": "string"
    },
    "validation_level": {
      "default": "unknown",
      "enum": [
        "source_checked",
        "provider_only",
        "unknown"
      ],
      "title": "Validation Level",
      "type": "string"
    },
    "verification_timing": {
      "default": "not_verified",
      "enum": [
        "before_audio",
        "after_audio",
        "not_verified"
      ],
      "title": "Verification Timing",
      "type": "string"
    },
    "presentation": {
      "anyOf": [
        {
          "$ref": "#/$defs/PresentationContract"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "status",
    "display_text",
    "speech_text"
  ],
  "title": "AnswerBundle",
  "type": "object"
}
