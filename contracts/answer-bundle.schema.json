{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "citation_id": {
          "title": "Citation Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "version_id": {
          "title": "Version Id",
          "type": "string"
        },
        "business_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Business Version"
        },
        "updated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Context"
        },
        "trace_id": {
          "title": "Trace Id",
          "type": "string"
        },
        "retrieval_id": {
          "title": "Retrieval Id",
          "type": "string"
        },
        "retrieval_status": {
          "default": "ok",
          "enum": [
            "ok",
            "degraded",
            "not_found",
            "needs_clarification"
          ],
          "title": "Retrieval Status",
          "type": "string"
        },
        "evidence_status": {
          "default": "unassessed",
          "enum": [
            "unassessed",
            "sufficient",
            "insufficient",
            "conflicting"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "degraded_reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Degraded Reasons",
          "type": "array"
        },
        "scope_limited": {
          "default": false,
          "title": "Scope Limited",
          "type": "boolean"
        },
        "content_revisions": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Content Revisions",
          "type": "object"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "title_path": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Title Path",
          "type": "array"
        },
        "anchor": {
          "additionalProperties": true,
          "title": "Anchor",
          "type": "object"
        },
        "retrieval_sources": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Retrieval Sources",
          "type": "array"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "authorized_kb_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Authorized Kb Ids",
          "type": "array"
        },
        "is_mock": {
          "default": false,
          "title": "Is Mock",
          "type": "boolean"
        }
      },
      "required": [
        "citation_id",
        "document_id",
        "chunk_id",
        "title",
        "version_id",
        "content",
        "trace_id",
        "retrieval_id",
        "rank"
      ],
      "title": "Citation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer_id": {
      "title": "Answer Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "answered",
        "needs_clarification",
        "insufficient_evidence",
        "failed",
        "canceled"
      ],
      "title": "Status",
      "type": "string"
    },
    "display_text": {
      "title": "Display Text",
      "type": "string"
    },
    "speech_text": {
      "title": "Speech Text",
      "type": "string"
    },
    "speech_language": {
      "default": "zh-CN",
      "title": "Speech Language",
      "type": "string"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "cards": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Cards",
      "type": "array"
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "is_mock": {
      "default": false,
      "title": "Is Mock",
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "display_text",
    "speech_text"
  ],
  "title": "AnswerBundle",
  "type": "object"
}
