{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "citation_id": {
          "title": "Citation Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "source_uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Uri"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "updated_at": {
          "title": "Updated At",
          "type": "string"
        },
        "content": {
          "title": "Content",
          "type": "string"
        },
        "retrieval_id": {
          "title": "Retrieval Id",
          "type": "string"
        },
        "authorized_kb_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Authorized Kb Ids",
          "type": "array"
        },
        "is_mock": {
          "default": false,
          "title": "Is Mock",
          "type": "boolean"
        }
      },
      "required": [
        "citation_id",
        "document_id",
        "chunk_id",
        "title",
        "version",
        "updated_at",
        "content",
        "retrieval_id"
      ],
      "title": "Citation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer_id": {
      "title": "Answer Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "answered",
        "needs_clarification",
        "insufficient_evidence",
        "failed",
        "canceled"
      ],
      "title": "Status",
      "type": "string"
    },
    "display_text": {
      "title": "Display Text",
      "type": "string"
    },
    "speech_text": {
      "title": "Speech Text",
      "type": "string"
    },
    "speech_language": {
      "default": "zh-CN",
      "title": "Speech Language",
      "type": "string"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "cards": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Cards",
      "type": "array"
    },
    "reason_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Code"
    },
    "is_mock": {
      "default": false,
      "title": "Is Mock",
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "display_text",
    "speech_text"
  ],
  "title": "AnswerBundle",
  "type": "object"
}
